# ==========================================
# Maran Media — Email Service Configuration
# ==========================================
# To send real project inquiry emails to maranmedia18@gmail.com
# AND send automatic confirmation replies to clients:
#
# If using Gmail:
# 1. Go to Google Account > Security
# 2. Enable 2-Step Verification
# 3. Search for "App Passwords" and generate one for "Mail" (16 letters)
# 4. Copy this file to `.env` and paste your password below:

SMTP_USER=maranmedia18@gmail.com
SMTP_PASS=your_16_character_gmail_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
